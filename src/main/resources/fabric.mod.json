{
	"schemaVersion": 1,
	"id": "lazy_chunks",
	"version": "${version}",
	"name": "LazyChunks-Shmily移植",
	"description": "Reduces stutters by spreading chunk loading across multiple frames,由B站up主在下Shmily移植，原作者rizen",
	"authors": [
		"rizen",
        "Shmily"
	],
	"contact": {
		"homepage": "https://space.bilibili.com/1576498148?spm_id_from=333.1007.0.0",
		"sources": "https://github.com/IamShmilyou/LazyChunk",
		"issues": "https://github.com/IamShmilyou/LazyChunk/issues"
	},
	"license": "LGPL-3.0",
	"icon": "assets/lazy_chunks/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"net.rizen.lazy_chunks.LazyChunksMod"
		],
		"sodium:config_api_user": [
			"net.rizen.lazy_chunks.sodium.LazyChunksSodiumConfigEntrypoint"
		]
	},
	"mixins": [
		"lazy_chunks.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": ">=1.21.11 <=1.21.11",
		"java": ">=21"
	}
}
